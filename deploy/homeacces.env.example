# /etc/homeacces/homeacces.env — read by the homeacces systemd service.
# install.sh creates this file with a random secret; edit and `systemctl restart homeacces`.

# Random string, at least 32 characters: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
HOMEACCES_SECRET_KEY=change-me

HOMEACCES_DATABASE=/var/lib/homeacces/homeacces.sqlite3

# Token lifetimes
HOMEACCES_ACCESS_TTL_MIN=15
HOMEACCES_REFRESH_TTL_DAYS=7

# Cookies are only sent over HTTPS when 1. Keep 1 in production.
HOMEACCES_COOKIE_SECURE=1

# Allow anyone who can reach the site to self-register (role "user"). Off by default: only admins
# create accounts. This is only the default: once an admin changes it in Admin → Settings, the UI
# setting wins.
HOMEACCES_ALLOW_REGISTRATION=0

# Activity log (sign-ins, account and item changes): appended to this file (empty = database
# only, see Admin → Activity log). Rotated by /etc/logrotate.d/homeacces.
HOMEACCES_ACTIVITY_LOG=/var/log/homeacces/activity.log
# Days to keep activity entries in the database (0 = forever).
HOMEACCES_ACTIVITY_RETENTION_DAYS=365

# Login brute-force protection: max failures per IP+username within the window.
HOMEACCES_LOGIN_MAX_FAILURES=5
HOMEACCES_LOGIN_WINDOW_SECONDS=900

# ---- PAM login and web terminal (homeacces-privd) ----
# Allow signing in with Raspberry Pi system accounts. PAM sessions get the web terminal.
HOMEACCES_PAM_ENABLED=1
# Only members of this system group may sign in with PAM (add users: sudo usermod -aG homeacces-pam pi).
HOMEACCES_PAM_GROUP=homeacces-pam
# Accounts below this uid (root, daemons) are always refused.
HOMEACCES_PAM_MIN_UID=1000
# PAM users in this group get the web "admin" role. Empty = no PAM user is admin.
HOMEACCES_PAM_ADMIN_GROUP=sudo
HOMEACCES_PRIVD_SOCKET=/run/homeacces/privd.sock
HOMEACCES_TERMINAL_LISTEN=127.0.0.1:8001
# Close a terminal after this many minutes without keyboard input.
HOMEACCES_TERMINAL_IDLE_MIN=30
HOMEACCES_TERMINAL_MAX_PER_USER=4
HOMEACCES_TERMINAL_MAX_TOTAL=16
